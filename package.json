{
  "name": "@catchhr/nestjs-bullseye",
  "version": "0.1.5",
  "description": "Embedded Bull queue dashboard (SPA + REST) for NestJS with Express",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/catch-talents/bullseye.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "bull",
    "queue",
    "dashboard",
    "redis"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "npm run build:frontend && npm run build:lib",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:frontend": "npm install --prefix frontend && npm run build --prefix frontend",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/bull": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "bull": "^4.16.0",
    "bullmq": "^5.0.0",
    "express": "^4.21.0 || ^5.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "bull": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express-basic-auth": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "bull": "^4.16.5",
    "bullmq": "^5.76.8",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
